# Configuração do app de transcrição (copie para .env e ajuste)

# Modelo Whisper padrão: tiny, base, small, medium, large, turbo
WHISPER_MODEL=turbo

# URL da API do Ollama (LLM local)
OLLAMA_URL=http://localhost:11434

# Modelo do Ollama usado nas ações de LLM (baixe com: ollama pull llama3.1:8b)
OLLAMA_MODEL=llama3.1:8b

# Pasta onde ficam áudios, exports e o banco SQLite
DATA_DIR=./data

# Porta do backend
PORT=8000

# Dispositivo: auto (detecta CUDA), cpu ou cuda
DEVICE=auto
